      "skillId": "skill.run",
      "passageId": "p.thief",
      "prompt": "点选表示盗贼奔逃的字。",
      "options": [
        {
          "id": "q7.1",
          "spanId": "s.q7.1",
          "reason": "“惧”是害怕，写心理。"
        },
        {
          "id": "q7.2",
          "spanId": "s.q7.2",
          "reason": "“弃”是丢下，写处置袋子的动作。"
        },
        {
          "id": "q7.3",
          "spanId": "s.q7.3",
          "reason": "“走”写出奔逃的动作。"
        }
      ],
      "answer": [
        "q7.3"
      ],
      "analysis": "“惧追者”给出原因。盗贼丢下袋子，是为了赶紧跑开。",
      "hint": "区分丢下物品和改变位置的动作。"
    },
    {
      "id": "q.8",
      "status": "draft",
      "mode": "choice",
      "skillId": "skill.leave",
      "passageId": "p.school",
      "prompt": "这句话中，老师与学生分别在哪里？",
      "options": [
        {
          "id": "q8.1",
          "label": "老师仍在堂中，学生已走",
          "reason": "把两个主语与动作对调了。"
        },
        {
          "id": "q8.2",
          "label": "老师已离开，学生仍在堂中",
          "reason": "“既去”和“犹坐”正好形成对照。"
        },
        {
          "id": "q8.3",
          "label": "师生一同前往学堂",
