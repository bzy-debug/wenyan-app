  "questions": [
    {
      "id": "q.1",
      "status": "draft",
      "mode": "choice",
      "skillId": "skill.run",
      "passageId": "p.fire",
      "prompt": "这里的“走”最接近哪一种动作？",
      "options": [
        {
          "id": "q1.1",
          "label": "缓步前行",
          "reason": "“争”与“避”写出事态紧急，缓行不合情境。"
        },
        {
          "id": "q1.2",
          "label": "奔跑",
          "reason": "“争走”写众人争相奔逃。"
        },
        {
          "id": "q1.3",
          "label": "出游",
          "reason": "人们是在避火，句中没有游览之意。"
        }
      ],
      "answer": [
        "q1.2"
      ],
      "analysis": "“以避之”点明行动目的。为躲开火势，众人争相奔跑。",
      "hint": "看“以避之”：人们遇到了什么危险？"
    },
    {
      "id": "q.2",
      "status": "draft",
      "mode": "choice",
      "skillId": "skill.leave",
      "passageId": "p.boat",
      "prompt": "“去岸”写的是哪一种移动？",
      "options": [
        {
          "id": "q2.1",
          "label": "前往岸边",
          "reason": "下一步是登船，岸是起点。"
        },
        {
          "id": "q2.2",
          "label": "沿岸行走",
          "reason": "“岸”是客人离开的地方，未写沿岸路线。"
        },
        {
          "id": "q2.3",
          "label": "离开岸边",
          "reason": "登船与离岸的方向一致。"
        }
      ],
      "answer": [
        "q2.3"
      ],
      "analysis": "“舟将发”交代背景。“去岸”与“登舟”相接，动作从岸上开始。",
      "hint": "抓住后面的动作“登舟”。"
    },
    {
      "id": "q.3",
      "status": "draft",
      "mode": "span",
      "skillId": "skill.hear",
      "passageId": "p.bell",
      "prompt": "点选原文中说明童子听到什么的词。",
      "options": [
        {
          "id": "q3.1",
          "spanId": "s.q3.1",
          "reason": "这是听声的人。"
        },
        {
          "id": "q3.2",
          "spanId": "s.q3.2",
          "reason": "这是被听见的声音。"
        },
        {
          "id": "q3.3",
          "spanId": "s.q3.3",
          "reason": "这是听到钟声之后的行动。"
        }
      ],
      "answer": [
        "q3.2"
      ],
      "analysis": "“钟声”是“闻”的对象，说明此处写的是听觉。",
      "hint": "找表示声音来源的词。"
    },
    {
      "id": "q.4",
      "status": "draft",
      "mode": "choice",
      "skillId": "skill.run",
      "passageId": "p.rain",
      "prompt": "行人怎样进入亭中？",
      "options": [
        {
          "id": "q4.1",
          "label": "快跑进去",
          "reason": "“疾走”说明奔跑得很快。"
        },
        {
          "id": "q4.2",
          "label": "快步走过去散心",
          "reason": "“雨骤至”交代避雨的情境。"
        },
        {
          "id": "q4.3",
          "label": "停下来观雨",
          "reason": "“入亭”写出了位置变化。"
        }
      ],
      "answer": [
        "q4.1"
      ],
      "analysis": "“疾”修饰“走”，结合骤雨可读出跑入亭中避雨的动作。",
      "hint": "将“雨骤至”和“疾”联系起来。"
    },
    {
      "id": "q.5",
      "status": "draft",
      "mode": "span",
      "skillId": "skill.leave",
      "passageId": "p.village",
      "prompt": "点选客人离开的地点。",
      "options": [
        {
          "id": "q5.1",
          "spanId": "s.q5.1",
          "reason": "“日暮”交代时间。"
        },
        {
          "id": "q5.2",
          "spanId": "s.q5.2",
          "reason": "朋友是告别的对象。"
        },
        {
          "id": "q5.3",
          "spanId": "s.q5.3",
          "reason": "“去村”的“村”指离开的地点。"
        }
      ],
      "answer": [
        "q5.3"
      ],
      "analysis": "“去村而归”写客人离开村子回家，“村”是“去”的对象。",
      "hint": "从“去”后面寻找地点。"
    },
    {
      "id": "q.6",
      "status": "draft",
      "mode": "order",
      "skillId": "skill.hear",
      "passageId": "p.drum",
      "prompt": "按原文先后，点选三个动作。",
      "options": [
        {
          "id": "q6.1",
          "label": "走出军营",
          "reason": ""
        },
        {
          "id": "q6.2",
          "label": "听见鼓声",
          "reason": ""
        },
        {
          "id": "q6.3",
          "label": "拿起兵器",
          "reason": ""
        }
      ],
      "answer": [
        "q6.2",
        "q6.3",
        "q6.1"
      ],
      "analysis": "“闻鼓声”先写触发行动的声音；“乃”引出随后执戈、出营两个动作。",
      "hint": "“乃”后面的动作发生得更晚。"
    },
    {
      "id": "q.7",
      "status": "draft",
