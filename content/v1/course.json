      "glossRights": "项目自撰译注"
    },
    {
      "id": "p.door",
      "text": "闻门外有声，遂起。",
      "gloss": "听见门外有声音，于是起身。",
      "kind": "teaching",
      "status": "draft",
      "textRights": "项目自撰教学例句",
      "glossRights": "项目自撰译注"
    },
    {
      "id": "p.fire",
      "text": "火起，众争走以避之。",
      "gloss": "起火了，众人争相奔跑以躲避火。",
      "kind": "teaching",
      "status": "draft",
      "textRights": "项目自撰教学例句",
      "glossRights": "项目自撰译注"
    },
    {
      "id": "p.boat",
      "text": "舟将发，客去岸登舟。",
      "gloss": "船将出发，旅客离开岸边登船。",
