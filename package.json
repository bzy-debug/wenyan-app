{
  "name": "wenyan-steps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run validate:content && npm test",
    "build": "npm run typecheck && npm run validate:content && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.79.0",
    "dexie": "^4.4.7",
    "markdown-it": "^14.3.3",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/user-event": "^14.6.13",
    "@testing-library/vue": "^8.1.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
